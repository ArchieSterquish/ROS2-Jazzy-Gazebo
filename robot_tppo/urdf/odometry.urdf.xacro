<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="libgz-sim8-odometry-publisher-system.so" name="gz::sim::systems::OdometryPublisher">
            <odom_topic>/gazebo_ground_truth/odom</odom_topic>
            
            <odom_frame>gazebo_odom</odom_frame>
            
            <robot_base_frame>base_link</robot_base_frame>
            
            <odom_publish_frequency>50</odom_publish_frequency>
            
            <tf_topic>/dev/null</tf_topic>
        </plugin>
    </gazebo>

</robot>
