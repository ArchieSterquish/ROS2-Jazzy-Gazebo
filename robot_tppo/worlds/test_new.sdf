<?xml version="1.0" ?>
<sdf version="1.8">

    <world name="Safety_Poligon_Final">

        <scene>
            <ambient>0.1 0.1 0.5 1</ambient>
            <background>0.2 0.2 0.8 1</background>
            <shadows>true</shadows>
        </scene>

        <physics name="1ms" type="ignored">
            <max_step_size>0.02</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
        <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="absolute_zero_ground">
            <static>true</static>
            <link name="link">
                <collision name="collision"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
                <visual name="visual">
                    <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
                    <material><ambient>1 0.5 0.8 1</ambient><diffuse>1 0.5 0.8 1</diffuse></material>
                </visual>
            </link>
        </model>

        <model name="spawn_hill_and_ramp">
            <static>true</static>

            <link name="spawn_platform">
                <pose>0 0 0.25 0 0 0</pose>
                <collision name="col"><geometry><box><size>1.0 1.2 0.5</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>1.0 1.2 0.5</size></box></geometry>
                    <material><ambient>0.3 0.3 0.4 1</ambient><diffuse>0.3 0.3 0.4 1</diffuse></material>
                </visual>
            </link>

            <link name="steep_ramp">
                <pose>1.05 0 0.26 0 0.38 0</pose> 
                <collision name="col"><geometry><box><size>1.3 1.2 0.02</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>1.3 1.2 0.02</size></box></geometry>
                    <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
                </visual>
            </link>
        </model>

        <model name="wide_ground_platform">
            <static>true</static>
            <pose>5.5 0 0.05 0 0 0</pose> <link name="main_floor_1">
                <pose>-2.1 0 0 0 0 0</pose>
                <collision name="col"><geometry><box><size>3.65 4.0 0.1</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>3.65 4.0 0.1</size></box></geometry>
                    <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
                </visual>
            </link>

            <link name="floor_around_pit_left">
                <pose>2.15 1.4 0 0 0 0</pose> 
                <collision name="col"><geometry><box><size>4.85 1.2 0.1</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>4.85 1.2 0.1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
            </link>
            <link name="floor_around_pit_right">
                <pose>2.15 -1.4 0 0 0 0</pose> 
                <collision name="col"><geometry><box><size>4.85 1.2 0.1</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>4.85 1.2 0.1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
            </link>
            <link name="floor_pit_back">
                <pose>-0.05 0 0 0 0 0</pose> 
                <collision name="col"><geometry><box><size>0.45 0.8 0.1</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>0.45 0.8 0.1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
            </link>
            <link name="floor_pit_front">
                <pose>2.95 0 0 0 0 0</pose> 
                <collision name="col"><geometry><box><size>3.25 0.8 0.1</size></box></geometry></collision>
                <visual name="vis"><geometry><box><size>3.25 0.8 0.1</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
            </link>
        </model>

        <model name="lidar_walls">
            <static>true</static>
            <pose>2.8 0 0.1 0 0 0</pose> 

            <link name="left_wall">
                <pose>0 0.3 0.15 0 0 0</pose>
                <collision name="c"><geometry><box><size>1.6 0.05 0.3</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>1.6 0.05 0.3</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
                </visual>
            </link>

            <link name="right_wall">
                <pose>0 -0.3 0.15 0 0 0</pose>
                <collision name="c"><geometry><box><size>1.6 0.05 0.3</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>1.6 0.05 0.3</size></box></geometry>
                    <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
                </visual>
            </link>
        </model>



        <model name="stability_testing_stones">
            <static>true</static>
            <pose>4.6 0 0.1 0 0 0</pose>

            <link name="stone_l1">
                <pose>-0.5 0.12 -0.01 0 0 0</pose>
                <collision name="c"><geometry><sphere><radius>0.04</radius></sphere></geometry></collision>
                <visual name="v"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
            </link>

            <link name="stone_r1">
                <pose>-0.3 -0.14 -0.01 0 0 0</pose>
                <collision name="c"><geometry><sphere><radius>0.04</radius></sphere></geometry></collision>
                <visual name="v"><geometry><sphere><radius>0.04</radius></sphere></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
            </link>

            <link name="stone_c1">
                <pose>-0.1 0.0 0.01 0 0 0</pose>
                <collision name="c"><geometry><box><size>0.06 0.35 0.03</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.06 0.35 0.03</size></box></geometry><material><ambient>0.5 0.3 0.1 1</ambient></material></visual>
            </link>

            <link name="stone_l2">
                <pose>0.1 0.15 -0.015 0 0 0</pose>
                <collision name="c"><geometry><sphere><radius>0.035</radius></sphere></geometry></collision>
                <visual name="v"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
            </link>

            <link name="stone_r2">
                <pose>0.3 -0.12 -0.012 0 0 0</pose>
                <collision name="c"><geometry><sphere><radius>0.038</radius></sphere></geometry></collision>
                <visual name="v"><geometry><sphere><radius>0.038</radius></sphere></geometry><material><ambient>0.6 0.4 0.2 1</ambient></material></visual>
            </link>
        </model>








        <model name="pit_warning_borders">
            <static>true</static>
            <pose>6.9 0 0.101 0 0 0</pose>
            <link name="borders">
                <visual name="b1"><pose>-0.4 0 0 0 0 0</pose><geometry><box><size>0.02 0.8 0.002</size></box></geometry><material><ambient>1 0 0 1</ambient></material></visual>
            </link>
        </model>

    </world>
</sdf>
